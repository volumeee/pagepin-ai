{
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/index.html",
    "default_title": "PagePin AI \u2014 Web Annotator"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "annotate": {
      "description": "Start annotating (pick element)",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    },
    "copy-report": {
      "description": "Copy the PagePin report as Markdown with screenshots",
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    },
    "copy-screenshot": {
      "description": "Copy the latest PagePin screenshot as PNG",
      "suggested_key": {
        "default": "Alt+Shift+I"
      }
    },
    "copy-console": {
      "description": "Copy captured PagePin console entries",
      "suggested_key": {
        "default": "Alt+Shift+K"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "description": "Annotate webpage elements, capture screenshots, and export AI-ready feedback reports. Local-first; no account or tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "PagePin AI \u2014 Web Annotator",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "version": "0.6.25"
}
